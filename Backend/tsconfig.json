{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./build",
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "5.0",
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true
  }
}
