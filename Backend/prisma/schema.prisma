// ===========================================
// BARBEARIA - Schema Prisma (PostgreSQL)
// Fase 1: Fundacao multi-barbearias
// ===========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Barbearia {
  idBarbearia  Int               @id @default(autoincrement()) @map("id_barbearia")
  nomeFantasia String            @map("nome_fantasia")
  razaoSocial  String?           @map("razao_social")
  cnpj         String?           @unique
  slug         String            @unique
  telefone     String?
  email        String?
  endereco     String?
  logoUrl      String?           @map("logo_url")
  corPrimaria  String?           @map("cor_primaria")
  ativo        Boolean           @default(true)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  usuariosBarbearias UsuarioBarbearia[]
  clientes           Cliente[]
  barbeiros          Barbeiro[]
  servicos           Servico[]
  agendamentos       Agendamento[]
  produtos           Produto[]
  vendas             Venda[]

  @@map("BARBEARIAS")
}

model Usuario {
  idUsuario      Int               @id @default(autoincrement()) @map("id_usuario")
  nome           String
  email          String            @unique
  senhaHash      String            @map("senha_hash")
  tipoUsuario    TipoUsuario       @map("tipo_usuario")
  dataCriacao    DateTime          @default(now()) @map("data_criacao")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  ativo          Boolean           @default(true)

  cliente        Cliente[]
  barbeiro       Barbeiro[]
  usuariosBarbearias UsuarioBarbearia[]

  @@map("USUARIOS")
}

model UsuarioBarbearia {
  idUsuarioBarbearia Int             @id @default(autoincrement()) @map("id_usuario_barbearia")
  idUsuario          Int             @map("id_usuario")
  idBarbearia        Int             @map("id_barbearia")
  papel              PapelBarbearia
  ativo              Boolean         @default(true)
  dataEntrada        DateTime        @default(now()) @map("data_entrada")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  usuario            Usuario         @relation(fields: [idUsuario], references: [idUsuario])
  barbearia          Barbearia       @relation(fields: [idBarbearia], references: [idBarbearia])

  @@unique([idUsuario, idBarbearia], map: "USUARIO_BARBEARIA_usuario_barbearia_key")
  @@map("USUARIOS_BARBEARIAS")
}

model Cliente {
  idCliente         Int         @id @default(autoincrement()) @map("id_cliente")
  idUsuario         Int         @map("id_usuario")
  idBarbearia       Int         @map("id_barbearia")
  telefone          String?
  dataNascimento    DateTime?   @map("data_nascimento")
  observacoes       String?
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  usuario           Usuario     @relation(fields: [idUsuario], references: [idUsuario])
  barbearia         Barbearia   @relation(fields: [idBarbearia], references: [idBarbearia])
  agendamentos      Agendamento[]
  vendas            Venda[]

  @@unique([idUsuario, idBarbearia], map: "CLIENTES_usuario_barbearia_key")
  @@map("CLIENTES")
}

model Barbeiro {
  idBarbeiro        Int         @id @default(autoincrement()) @map("id_barbeiro")
  idUsuario         Int         @map("id_usuario")
  idBarbearia       Int         @map("id_barbearia")
  especialidade     String?
  comissao          Decimal?
  telefone          String?
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  usuario           Usuario     @relation(fields: [idUsuario], references: [idUsuario])
  barbearia         Barbearia   @relation(fields: [idBarbearia], references: [idBarbearia])
  agendamentos      Agendamento[]

  @@unique([idUsuario, idBarbearia], map: "BARBEIROS_usuario_barbearia_key")
  @@map("BARBEIROS")
}

model Servico {
  idServico         Int         @id @default(autoincrement()) @map("id_servico")
  idBarbearia       Int         @map("id_barbearia")
  nome              String
  descricao         String?
  preco             Decimal
  duracaoMin        Int         @map("duracao_min")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  barbearia         Barbearia   @relation(fields: [idBarbearia], references: [idBarbearia])
  agendamentos      Agendamento[]

  @@map("SERVICOS")
}

model Agendamento {
  idAgendamento     Int                @id @default(autoincrement()) @map("id_agendamento")
  idBarbearia       Int                @map("id_barbearia")
  idCliente         Int                @map("id_cliente")
  idBarbeiro        Int                @map("id_barbeiro")
  idServico         Int                @map("id_servico")
  dataHoraInicio    DateTime           @map("data_hora_inicio")
  dataHoraFim       DateTime           @map("data_hora_fim")
  status            StatusAgendamento  @default(pendente)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  barbearia         Barbearia          @relation(fields: [idBarbearia], references: [idBarbearia])
  cliente           Cliente            @relation(fields: [idCliente], references: [idCliente])
  barbeiro          Barbeiro           @relation(fields: [idBarbeiro], references: [idBarbeiro])
  servico           Servico            @relation(fields: [idServico], references: [idServico])

  @@map("AGENDAMENTOS")
}

model Produto {
  idProduto         Int         @id @default(autoincrement()) @map("id_produto")
  idBarbearia       Int         @map("id_barbearia")
  nome              String
  categoria         String?
  preco             Decimal
  quantidade        Int         @default(0)
  dataCadastro      DateTime    @default(now()) @map("data_cadastro")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  barbearia         Barbearia   @relation(fields: [idBarbearia], references: [idBarbearia])
  vendaProdutos     VendaProduto[]

  @@map("PRODUTOS")
}

model Venda {
  idVenda           Int              @id @default(autoincrement()) @map("id_venda")
  idBarbearia       Int              @map("id_barbearia")
  idCliente         Int?             @map("id_cliente")
  dataVenda         DateTime         @default(now()) @map("data_venda")
  valorTotal        Decimal          @map("valor_total")
  formaPagamento    MetodoPagamento  @map("forma_pagamento")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  barbearia         Barbearia        @relation(fields: [idBarbearia], references: [idBarbearia])
  cliente           Cliente?         @relation(fields: [idCliente], references: [idCliente])
  vendaProdutos     VendaProduto[]

  @@map("VENDAS")
}

model VendaProduto {
  idVenda           Int       @map("id_venda")
  idProduto         Int       @map("id_produto")
  quantidade        Int       @default(1)
  precoUnit         Decimal   @map("preco_unit")

  venda             Venda     @relation(fields: [idVenda], references: [idVenda])
  produto           Produto   @relation(fields: [idProduto], references: [idProduto])

  @@id([idVenda, idProduto])
  @@map("ITENS_VENDA")
}

enum TipoUsuario {
  owner
  admin
  gerente
  barbeiro
  recepcao
  financeiro
  cliente
}

enum PapelBarbearia {
  owner
  admin
  gerente
  barbeiro
  recepcao
  financeiro
  cliente
}

enum StatusAgendamento {
  pendente
  confirmado
  cancelado
  concluido
}

enum MetodoPagamento {
  dinheiro
  pix
  cartao
}
